    "type": "git",
    "url": "git+https://github.com/The-killing-joke/ProyectoM2_Frederick.git"
  },
  "keywords": ["express", "postgresql", "api", "blog"],
  "author": "Frederick",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
  "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/The-killing-joke/ProyectoM2_Frederick/issues"
  },
  "homepage": "https://github.com/The-killing-joke/ProyectoM2_Frederick#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
